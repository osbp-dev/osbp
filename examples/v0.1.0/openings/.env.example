# Openings demo salon config for the v0.1.0 proof of concept.
# Copy to .env.local and fill with the sandbox ids provisioned in Openings:
# one salon, one schedule, one provider, one service
# (paymentRequirement: NONE, no deposit), and a reusable test customer.
# Do not commit .env.local or live SMS-capable test fixture values.
#
# This file is all you need to run this example: copy it to .env.local in this
# directory (.env.local is gitignored) and fill in the values below.

OPENINGS_API_BASE_URL=https://api.openings.link
OPENINGS_SALON_SLUG=

# Environment-specific Openings fixture ids.
# OPENINGS_SERVICE_IDS: list the simplest non-consultation service first —
# the trace generator picks serviceIds[0]. Services with hasConsultation: true
# (e.g., "Color" in the current demo) cannot be booked directly through
# /v1/appointments/create; Openings rejects them and OSBP's contract requires
# routing them to handoff.request. Putting a hasConsultation: false,
# paymentRequirement: NONE service first (e.g., "Short Haircut") keeps the
# golden trace producible end-to-end.
OPENINGS_SALON_ID=
OPENINGS_SCHEDULE_IDS=
OPENINGS_STAFF_USER_IDS=
OPENINGS_SERVICE_IDS=

# Seeded reusable test customer.
# Live SMS-capable test fixture value; keep it in local config or manual-run secrets.
OPENINGS_TEST_CUSTOMER_ID=
OPENINGS_TEST_CUSTOMER_PHONE=

# Local idempotency cache for booking.create retries. This is the authoritative
# OSBP idempotency mechanism — Openings' `requestId` field is NOT an idempotency
# key (it's the FK to a ServiceRequest record in the consultation/
# quote workflow). The adapter consults this cache before each create call and
# short-circuits on a payload-hash match.
OSBP_IDEMPOTENCY_STORE_PATH=.osbp/idempotency/openings-v0.1.0.json
